<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ImageViewer.ViewModels"
        x:Class="ImageViewer.Views.ImageListWindow"
        x:DataType="vm:ImageListViewModel"
        Title="{Binding Title}"
        Icon="avares://ImageViewer/Resources/ImageViewer.ico"
        Width="760" Height="640" MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="ListBox#ThumbnailStrip ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#ThumbnailStrip ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#ThumbnailStrip ListBoxItem:selected Border.ThumbCard">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#FF203450" />
        </Style>
        <Style Selector="ListBox#ThumbnailStrip ListBoxItem:pointerover Border.ThumbCard">
            <Setter Property="BorderBrush" Value="#FF777777" />
        </Style>

        <Style Selector="Button.ColumnHeader">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFF3F3F5" />
            <Setter Property="BorderBrush" Value="#FFD8D8DE" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox#List ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBlock.Unsupported">
            <Setter Property="Foreground" Value="Gray" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="10">
        <!-- 상단 썸네일 줄 -->
        <Border DockPanel.Dock="Top" Background="#FF1E1E1E" CornerRadius="6" Padding="6,6,6,2" Margin="0,0,0,10"
                IsVisible="{Binding HasThumbnails}">
            <ListBox x:Name="ThumbnailStrip"
                     ItemsSource="{Binding Thumbnails}"
                     SelectedIndex="{Binding SelectedThumbnailIndex, Mode=TwoWay}"
                     Focusable="False"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ThumbnailItemViewModel}">
                        <Grid>
                            <Border Classes="ThumbCard" BorderThickness="2" BorderBrush="Transparent" CornerRadius="4"
                                    Background="#FF2A2A2A" Padding="2" Margin="0,0,0,6">
                                <Grid Width="96" Height="96" ToolTip.Tip="{Binding ToolTip}">
                                    <TextBlock Text="{Binding Name}" Foreground="#FF808080" FontSize="10"
                                               IsVisible="{Binding Thumbnail, Converter={StaticResource InverseBoolToVisibility}}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="4" />
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Grid>
                            </Border>
                            <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                     IsVisible="{Binding IsCurrent}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="확인" Width="84" Height="28" IsDefault="True" Click="OnOk" />
        </StackPanel>

        <Border BorderBrush="#FFD0D0D6" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <!-- 열 헤더 -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,140,110">
                    <Button Classes="ColumnHeader" Content="{Binding NameHeader}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ImageListSortColumn.Name}" />
                    <Button Grid.Column="1" Classes="ColumnHeader" Content="{Binding DateHeader}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ImageListSortColumn.Date}" />
                    <Button Grid.Column="2" Classes="ColumnHeader" BorderThickness="0,0,0,1" Content="{Binding SizeHeader}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ImageListSortColumn.Size}" />
                </Grid>

                <!-- 파일 목록 -->
                <ListBox x:Name="List"
                         ItemsSource="{Binding ItemsView}"
                         SelectedItem="{Binding SelectedItem}"
                         SelectionMode="Single"
                         Background="Transparent"
                         BorderThickness="0"
                         DoubleTapped="OnListDoubleTapped"
                         SelectionChanged="OnListSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ImageListItem}">
                            <Grid ColumnDefinitions="*,140,110" Margin="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="● " Foreground="#FF3D8BFD">
                                        <TextBlock.IsVisible>
                                            <MultiBinding Converter="{x:Static vm:IsCurrentItemConverter.Instance}">
                                                <Binding Path="Index" />
                                                <Binding Path="((vm:ImageListViewModel)DataContext).CurrentIndex"
                                                         RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </MultiBinding>
                                        </TextBlock.IsVisible>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Classes.Unsupported="{Binding !IsSupported}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DateText}" Margin="8,0,0,0"
                                           Classes.Unsupported="{Binding !IsSupported}" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" TextAlignment="Right" Margin="8,0,0,0"
                                           Classes.Unsupported="{Binding !IsSupported}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
