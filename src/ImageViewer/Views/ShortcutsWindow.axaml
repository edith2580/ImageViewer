<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ImageViewer.Views"
        x:Class="ImageViewer.Views.ShortcutsWindow"
        x:DataType="views:ShortcutsWindow"
        Title="단축키 안내"
        Icon="avares://ImageViewer/Resources/ImageViewer.ico"
        Width="660"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="Border.GroupCard">
            <Setter Property="BorderBrush" Value="#FFD0D0D6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF333333" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.KeyBadge">
            <Setter Property="Background" Value="#FFF2F3F7" />
            <Setter Property="BorderBrush" Value="#FFD0D4DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.KeyText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF222222" />
        </Style>
        <Style Selector="TextBlock.DescText">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#FF333333" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom"
                Content="닫기"
                Width="88"
                Height="28"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="OnClose" />

        <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ShortcutGroup">
                        <Border Classes="GroupCard">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Classes="GroupHeader" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="views:ShortcutItem">
                                            <Border BorderBrush="#FFECEEF2" BorderThickness="0,0,0,1" Padding="0,4">
                                                <Grid ColumnDefinitions="160,*">
                                                    <Border Grid.Column="0" Classes="KeyBadge">
                                                        <TextBlock Text="{Binding Key}" Classes="KeyText" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Classes="DescText" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
