<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ImageViewer.ViewModels">

    <Styles.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#FF1E1E1E" />
        <SolidColorBrush x:Key="PanelBorder" Color="#FF3A3A3A" />
        <SolidColorBrush x:Key="PanelForeground" Color="#FFE0E0E0" />
        <SolidColorBrush x:Key="SubtleForeground" Color="#FFA0A0A0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3D8BFD" />
        <SolidColorBrush x:Key="HoverBrush" Color="#FF333333" />
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="Slider:horizontal">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid VerticalAlignment="Center" Height="22">
                    <Track Name="PART_Track"
                           Orientation="Horizontal"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton"
                                          Focusable="False"
                                          Background="{StaticResource AccentBrush}"
                                          Height="4"
                                          CornerRadius="2"
                                          Padding="0"
                                          BorderThickness="0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton"
                                          Focusable="False"
                                          Background="#66888888"
                                          Height="4"
                                          CornerRadius="2"
                                          Padding="0"
                                          BorderThickness="0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch" />
                        </Track.IncreaseButton>
                        <Thumb Name="thumb"
                               Width="14"
                               Height="14"
                               MinWidth="14"
                               MinHeight="14"
                               Background="{StaticResource AccentBrush}"
                               BorderBrush="White"
                               BorderThickness="2"
                               VerticalAlignment="Center">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Border Width="14"
                                            Height="14"
                                            CornerRadius="7"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Slider:horizontal /template/ Thumb#thumb:pointerover">
        <Setter Property="Background" Value="#FF5A9CFF" />
    </Style>

    <!-- 하단 바 버튼: 포커스를 가져가지 않아 키보드 단축키를 방해하지 않는다 -->
    <Style Selector="Button.ToolButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.ToolButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="Foreground" Value="#FF7DB4FF" />
    </Style>
    <Style Selector="Button.ToolButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FF444444" />
    </Style>
    <Style Selector="Button.ToolButton:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- 강조 버튼 (업데이트 알림의 [지금 업데이트]) -->
    <Style Selector="Button.AccentToolButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.AccentToolButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FF5A9CFF" />
    </Style>
    <Style Selector="Button.AccentToolButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FF2F74DB" />
    </Style>
    <Style Selector="Button.AccentToolButton:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- 아이콘 버튼 (크로스 플랫폼 벡터 PathIcon) -->
    <Style Selector="Button.IconButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.IconButton PathIcon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
    </Style>
    <Style Selector="Button.IconButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="#FF7DB4FF" />
    </Style>
    <Style Selector="Button.IconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="Foreground" Value="#FF7DB4FF" />
    </Style>
    <Style Selector="Button.IconButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FF444444" />
    </Style>
    <Style Selector="Button.IconButton:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- 직접 그린 타이틀바의 창 버튼 (최소화 / 최대화 / 닫기) -->
    <Style Selector="Button.CaptionButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="#FFE8E8E8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.CaptionButton PathIcon">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Foreground" Value="#FFE8E8E8" />
    </Style>
    <Style Selector="Button.CaptionButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="#FF7DB4FF" />
    </Style>
    <Style Selector="Button.CaptionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="Foreground" Value="#FF7DB4FF" />
    </Style>
    <Style Selector="Button.CaptionButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#22FFFFFF" />
    </Style>

    <Style Selector="Button.CloseCaptionButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="#FFE8E8E8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.CloseCaptionButton PathIcon">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Foreground" Value="#FFE8E8E8" />
    </Style>
    <Style Selector="Button.CloseCaptionButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.CloseCaptionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFC42B1C" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.CloseCaptionButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFC94F45" />
    </Style>

    <!-- macOS 스타일 타이틀바 신호등 버튼 (닫기 · 최소화 · 최대화) -->
    <Style Selector="Button.MacTrafficButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Width="12"
                        Height="12"
                        CornerRadius="6"
                        Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.MacTrafficButton PathIcon">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Foreground" Value="#B3000000" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="StackPanel.MacTrafficPanel:pointerover Button.MacTrafficButton PathIcon">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.MacTrafficButton:pressed">
        <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button.MacCloseButton">
        <Setter Property="Background" Value="#FFFF5F57" />
    </Style>
    <Style Selector="Button.MacMinimizeButton">
        <Setter Property="Background" Value="#FFFEBC2E" />
    </Style>
    <Style Selector="Button.MacMaximizeButton">
        <Setter Property="Background" Value="#FF28C840" />
    </Style>

    <!-- 썸네일 항목 -->
    <Style Selector="ListBox.ThumbnailList ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.ThumbnailList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 썸네일 목록 하단 수평 스크롤바: FluentTheme 템플릿을 유지하면서 Slider와 동일한 슬림 트랙 + 둥근 Thumb 적용 -->
    <Style Selector="ListBox.ThumbnailList ScrollBar:horizontal">
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.ThumbnailList ScrollBar:horizontal /template/ Border#HorizontalRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.ThumbnailList ScrollBar:horizontal /template/ Rectangle#TrackRect">
        <Setter Property="Height" Value="4" />
        <Setter Property="RadiusX" Value="2" />
        <Setter Property="RadiusY" Value="2" />
        <Setter Property="Fill" Value="#66888888" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.ThumbnailList ScrollBar:horizontal /template/ RepeatButton#PART_LineUpButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.ThumbnailList ScrollBar:horizontal /template/ RepeatButton#PART_LineDownButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.ThumbnailList ScrollBar:horizontal /template/ Track > Thumb">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="ListBox.ThumbnailList ScrollBar:horizontal /template/ Track > Thumb /template/ Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBox.ThumbnailList ScrollBar:horizontal:pointerover /template/ Track > Thumb">
        <Setter Property="Background" Value="#FF5A9CFF" />
    </Style>

    <!-- 상단 바 · 하단 바 고정(Pin) 토글 -->
    <Style Selector="ToggleButton.PinToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
        <Setter Property="ToolTip.Tip" Value="고정 (해제하면 마우스를 올렸을 때만 표시)" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <PathIcon x:Name="PART_PinIcon"
                              Data="{StaticResource IconPin}"
                              Width="14" Height="14"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.PinToggleButton:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="Foreground" Value="#FF7DB4FF" />
    </Style>
    <Style Selector="ToggleButton.PinToggleButton:checked">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="ToolTip.Tip" Value="고정 해제" />
    </Style>
    <Style Selector="ToggleButton.PinToggleButton:checked /template/ PathIcon#PART_PinIcon">
        <Setter Property="Data" Value="{StaticResource IconPinFilled}" />
    </Style>
    <Style Selector="ToggleButton.PinToggleButton:checked:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="Foreground" Value="#FF7DB4FF" />
    </Style>

    <!-- 상단 메뉴바의 최상위 메뉴 -->
    <Style Selector="Menu.TopMenu > MenuItem">
        <Setter Property="Foreground" Value="#FFE6E6E6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0,12,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Menu.TopMenu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#26FFFFFF" />
    </Style>
    <Style Selector="Menu.TopMenu > MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="#FF7DB4FF" />
    </Style>
    <Style Selector="Menu.TopMenu > MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#38FFFFFF" />
    </Style>
    <Style Selector="Menu.TopMenu > MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="#FFA9CDFF" />
    </Style>

    <Style Selector="TextBlock.StatusText">
        <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</Styles>
