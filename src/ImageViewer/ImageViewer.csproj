<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ImageViewer</RootNamespace>
    <AssemblyName>ImageViewer</AssemblyName>
    <Version>1.0.9</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>ImageViewer</Product>
    <Description>Cross-platform image viewer for folders and ZIP archives</Description>
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\ImageViewer.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Self-contained publish: dotnet publish -c Release -r win-x64 (see build/publish.ps1) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- win-x64 배포 시 멀티코어(OpenMP) 빌드 사용, 그 외(macOS/Linux/AnyCPU)는 AnyCPU 네이티브 번들 사용 -->
    <PackageReference Include="Magick.NET-Q8-OpenMP-x64" Version="15.1.0" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.1.0" Condition="'$(RuntimeIdentifier)' != 'win-x64'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 창 제목 표시줄 · 작업 표시줄용 아이콘 (exe 아이콘은 ApplicationIcon) -->
    <AvaloniaResource Include="Resources\ImageViewer.ico" />
    <AvaloniaResource Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- 자동 업데이트가 새 버전을 확인할 GitHub 저장소 (owner/name). 이 저장소의 최신 릴리스를 본다. -->
    <AssemblyMetadata Include="UpdateRepository" Value="edith2580/ImageViewer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageViewer.Tests" />
    <InternalsVisibleTo Include="ImageViewer.IntegrationTests" />
  </ItemGroup>

</Project>
